{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup CMake Project",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build/x64",
                "-G",
                "Visual Studio 17 2022",
                "-T",
                "v143",
                "-A",
                "x64"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile",
                "$cmake"
            ]
        },
        {
            "label": "Generate SOH OTR",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "./build/x64",
                "--target",
                "GenerateSohOtr"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Build Project",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "./build/x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["Generate SOH OTR"],
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Build All",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Setup CMake Project",
                "Generate SOH OTR",
                "Build Project"
            ],
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]            
        },
        {
            "label": "Build OTRExporter (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "./build/x64",
                "--config",
                "Debug",
                "--target",
                "OTRExporter",
                "-j",
                "14"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Build ZAPD (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "./build/x64",
                "--config",
                "Debug",
                "--target",
                "ZAPD",
                "-j",
                "14"
            ],
            "group": "build",
            "dependsOn": ["Build OTRExporter (Debug)"],
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "Launch SOH",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "(taskkill /F /IM soh.exe || echo Process not running) && start .\\x64\\Debug\\soh.exe"
            ],
            "dependsOn": [],
            "problemMatcher": []
        },
        {
            "label": "Build and Launch SOH",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "start .\\x64\\Debug\\soh.exe"
            ],
            "dependsOn": ["Build Project"],
            "problemMatcher": []
        }        
    ]
}